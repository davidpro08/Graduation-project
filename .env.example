# Docker Compose의 호스트 공개 포트. 복사 없이도 기본값으로 실행됩니다.
FRONTEND_PORT=5173
BACKEND_PORT=3000
# Windows Docker bind mount의 파일 변경 감지
WATCH_POLLING=true
# 백엔드 Auth 검증·사용자 RLS 접근에는 공개 키만 사용합니다.
SUPABASE_URL=https://fthzjaeucyiudbjxmlgu.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# 프론트는 위 공개 값을 사용합니다. 다른 프로젝트가 필요할 때만 아래 변수를 설정하세요.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 긴 대화 전체 분석 제한 시간: 기본 2시간, 1분~4시간 허용
ANALYSIS_TIMEOUT_MS=7200000
# Docker Desktop에서 호스트의 SSH 터널로 연결. 로컬 Nest 실행은 127.0.0.1:18080/v1 사용.
SCHOOL_AI_BASE_URL=http://host.docker.internal:18080/v1
SCHOOL_AI_MODEL=Qwen/Qwen3-32B-AWQ
SCHOOL_AI_API_KEY=

# 페르소나 조회는 기존 Supabase 공개 키와 로그인 JWT를 사용합니다. 추가 관리자 키는 필요하지 않습니다.
# 의견 분석 인원: 기본 상세 50 + JEV 50 = 총 100명. 각각 0~200, 합계 1~200.
# 조건에 맞는 표본이 적으면 상세 인원을 먼저 채웁니다. 변경 후 백엔드를 재시작하세요.
PERSONA_DETAIL_COUNT=50
PERSONA_JEV_COUNT=50
# 학교 자체 JEV 서버의 완전한 의견 API URL. persona-opinion-v1 계약은 .agents/AI/persona-debates.md 참조.
# 호스트: http://127.0.0.1:18081/v1/persona-opinion / Docker: http://host.docker.internal:18081/v1/persona-opinion
JEV_OPINIONS_URL=
JEV_OPINIONS_API_KEY=

# 문서의 핵심 외부 정보 조사. 키가 없으면 미연결 안내와 기존 초안을 제공합니다.
# https://app.tavily.com 에서 발급하며 프론트 NEXT_PUBLIC_ 변수로 노출하지 마세요.
TAVILY_API_KEY=

# Persisted claims -> JEV contradiction classification (requires bridge migration)
JEV_CLAIMS_URL=http://127.0.0.1:18081/v1/claim-pair
CLAIM_MAX_PAIRS=2000
