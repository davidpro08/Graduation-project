# Docker Compose의 호스트 공개 포트. 복사 없이도 기본값으로 실행됩니다.
FRONTEND_PORT=5173
BACKEND_PORT=3000
# Windows Docker bind mount의 파일 변경 감지
WATCH_POLLING=true
# 백엔드 Auth 검증·사용자 RLS 접근. 공개 키만 사용하며 서버 비밀 키는 필요하지 않습니다.
SUPABASE_URL=https://fthzjaeucyiudbjxmlgu.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# 프론트는 위 공개 값을 사용합니다. 다른 프로젝트가 필요할 때만 아래 변수를 설정하세요.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# JEV 사전 판단. 서버 전용; true일 때 TYPESAFE_API_KEY가 필수입니다.
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=5000
JEV_SKIP_THRESHOLD=0.2
# 긴 대화 전체 분석 제한 시간: 기본 2시간, 1분~4시간 허용
ANALYSIS_TIMEOUT_MS=7200000
# Docker Desktop에서 호스트의 SSH 터널로 연결. 로컬 Nest 실행은 127.0.0.1:18080/v1 사용.
SCHOOL_AI_BASE_URL=http://host.docker.internal:18080/v1
SCHOOL_AI_MODEL=Qwen/Qwen3-32B-AWQ
SCHOOL_AI_API_KEY=
