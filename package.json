{
  "name": "gratta-monorepo",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "turbo run dev --skip-infer --ui=stream",
    "build": "turbo run build --skip-infer",
    "typecheck": "turbo run typecheck --skip-infer",
    "lint": "turbo run lint --skip-infer",
    "test": "turbo run test --skip-infer",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "2.9.14"
  }
}
